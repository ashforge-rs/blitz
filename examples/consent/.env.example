# Consent app settings (consent_app/settings.py). The boilerplate's own settings
# (ENVIRONMENT, PORT, RATE_LIMIT, ...) are documented in the root .env.example.

# Which regulation's rules apply to this deployment. Profiles: gdpr.
CONSENT_PROFILE=gdpr
# Client systems allowed to record consent: comma-separated client=sha256(key).
# Create one with `make api-key CLIENT=crm`; the key itself is shown only then.
CONSENT_API_KEYS=
# SQLAlchemy URL: SQLite (default) or postgresql+asyncpg://user:password@host/db.
CONSENT_DATABASE_URL=sqlite+aiosqlite:///consent.db
# Apply pending migrations at startup. Set false in production and run
# `make migrate` as a release step instead.
CONSENT_DB_MIGRATE_ON_STARTUP=true
# Postgres: how long to wait for a new or pooled connection before failing.
CONSENT_DB_CONNECT_TIMEOUT_SECONDS=5
# How often business metrics (consent states, ledger tallies) are recomputed (seconds).
CONSENT_METRICS_REFRESH_SECONDS=15
