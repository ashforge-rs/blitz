# Todo app settings (todo_app/settings.py). The boilerplate's own settings
# (ENVIRONMENT, PORT, RATE_LIMIT, ...) are documented in the root .env.example.

# SQLite database file; both domains open it. Created on first start.
TODO_DB_PATH=todo.db
# How long a write waits for a lock held by another connection.
TODO_DB_BUSY_TIMEOUT_MS=5000
# How often the audit outbox relay delivers committed audit entries (seconds).
TODO_OUTBOX_POLL_INTERVAL_SECONDS=0.5
