# Todo app settings (todo_app/settings.py). The boilerplate's own settings
# (ENVIRONMENT, PORT, RATE_LIMIT, ...) are documented in the root .env.example.

# SQLAlchemy URL. SQLite (default) or Postgres, e.g.
#   postgresql+asyncpg://todo:todo@localhost:5432/todo   (see docker-compose.yml)
TODO_DATABASE_URL=sqlite+aiosqlite:///todo.db
# Apply pending migrations at startup. Set false in production and run
# `todo db upgrade` as a release step instead.
TODO_DB_MIGRATE_ON_STARTUP=true
# Postgres: how long to wait for a new or pooled connection before failing.
TODO_DB_CONNECT_TIMEOUT_SECONDS=5
# SQLite: how long a write waits for another connection's write lock.
TODO_DB_BUSY_TIMEOUT_MS=5000
# /health returns 503 once an audit entry has waited longer than this (seconds).
TODO_OUTBOX_MAX_AGE_SECONDS=300
# How often expired idempotency records (past the 24 h replay window) are purged.
TODO_IDEMPOTENCY_PURGE_INTERVAL_SECONDS=3600
# How often the audit outbox relay delivers committed audit entries (seconds).
TODO_OUTBOX_POLL_INTERVAL_SECONDS=0.5
