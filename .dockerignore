# Only pyproject.toml, uv.lock and src/ are COPY'd into the image; excluding
# everything else keeps the build context small and secrets out of it.

# Python / uv
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
*.egg-info/
dist/
build/

# Environment
.env
.env.*
!.env.example

# VCS / repo tooling (not needed in the image)
.git/
.github/
.claude/
openspec/
infra/
grafana/
scripts/
tests/
conftest.py
docker-compose.yml
*.md

# Dev tooling
.ruff_cache/
.pytest_cache/
.mypy_cache/
.hypothesis/
htmlcov/
coverage.xml
.coverage

# IDE
.vscode/
.idea/

# Secrets / keys
*.pem
*.key
*.crt
