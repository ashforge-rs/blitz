{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "services.api.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "env": {
        "ENVIRONMENT": "development",
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "envFile": "${workspaceFolder}/.env",
      "jinja": false,
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Dev server (no reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "services.api.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "env": {
        "ENVIRONMENT": "development",
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "envFile": "${workspaceFolder}/.env",
      "jinja": false,
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Test: all",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "tests/"
      ],
      "env": {
        "ENVIRONMENT": "test",
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Test: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "${file}"
      ],
      "env": {
        "ENVIRONMENT": "test",
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Test: unit",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "tests/global/unit/",
        "tests/domains/"
      ],
      "env": {
        "ENVIRONMENT": "test",
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Test: integration",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "tests/global/integration/",
        "-k",
        "integration"
      ],
      "env": {
        "ENVIRONMENT": "test",
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Generate OpenAPI schema",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/generate_openapi.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}"
    }
  ]
}
