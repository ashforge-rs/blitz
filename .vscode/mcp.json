{
    "servers": {
        // GitHub — read/write PRs, issues, review comments, and query Actions
        // workflow runs. Pairs well with the release-please and pr-title workflows.
        // Requires a PAT with: repo, read:org, workflow scopes.
        "github": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:githubToken}"
            }
        },
        // Fetch — issue HTTP requests against the running dev server (`make dev`)
        // to probe /health, /metrics and domain routes without leaving the editor.
        "fetch": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-fetch"
            ]
        }
        // Add a database server (e.g. @modelcontextprotocol/server-postgres) once a
        // domain is backed by one; the default stores are in-memory.
    },
    "inputs": [
        {
            "id": "githubToken",
            "type": "promptString",
            "description": "GitHub Personal Access Token (repo + workflow scopes)",
            "password": true
        }
    ]
}
