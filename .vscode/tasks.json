{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "install",
            "type": "shell",
            "command": "uv sync",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "dev",
            "type": "shell",
            "command": "uv run uvicorn services.api.main:app --reload --app-dir src",
            "group": "build",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Started reloader process",
                    "endsPattern": "Application startup complete"
                }
            }
        },
        {
            "label": "test",
            "type": "shell",
            "command": "uv run pytest -v",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "test: unit",
            "type": "shell",
            "command": "uv run pytest tests/global/unit/ tests/domains/*/unit/ -v",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "test: integration",
            "type": "shell",
            "command": "uv run pytest tests/global/integration/ tests/domains/*/integration/ -v",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "test: coverage",
            "type": "shell",
            "command": "uv run pytest --cov=src --cov-report=term-missing --cov-report=html --cov-fail-under=80",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "fmt",
            "type": "shell",
            "command": "uv run ruff format src/ tests/",
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "lint",
            "type": "shell",
            "command": "uv run ruff check src/ tests/",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "ruff",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+)\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "check",
            "type": "shell",
            "command": "uv run ruff format src/ tests/ && uv run ruff check src/ tests/ && uv run mypy src/",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "openapi: generate",
            "type": "shell",
            "command": "uv run python scripts/generate_openapi.py",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "docker: build",
            "type": "shell",
            "command": "docker build --file src/services/api/Dockerfile --tag blitz-api:local .",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "docker: compose up",
            "type": "shell",
            "command": "docker compose up --build",
            "group": "build",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "docker: compose down",
            "type": "shell",
            "command": "docker compose down",
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean",
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
