"""KeyValueStore on PostgreSQL: pydantic models as JSONB rows keyed by (namespace, key)."""

import re
from typing import TYPE_CHECKING

from pydantic import BaseModel

if TYPE_CHECKING:
    import asyncpg

_IDENTIFIER = re.compile(r"^[a-z_][a-z0-9_]*$$")


class PostgresStore[V: BaseModel]:
    """Satisfies ``KeyValueStore[str, V]``. Call ``ensure_table()`` once at startup.

    Every store shares one table; ``namespace`` keeps their keys apart. For queries
    beyond key lookups, give the domain its own table and repository instead.
    """

    def __init__(
        self, pool: asyncpg.Pool, model: type[V], *, namespace: str, table: str = "kv_store"
    ) -> None:
        if not _IDENTIFIER.match(table):
            raise ValueError(f"invalid table name {table!r}")
        self._pool = pool
        self._model = model
        self._namespace = namespace
        self._table = table

    async def ensure_table(self) -> None:
        await self._pool.execute(
            f"CREATE TABLE IF NOT EXISTS {self._table} ("  # table name validated in __init__
            "namespace text NOT NULL, key text NOT NULL, value jsonb NOT NULL, "
            "PRIMARY KEY (namespace, key))"
        )

    async def get(self, key: str) -> V | None:
        raw = await self._pool.fetchval(
            f"SELECT value FROM {self._table} WHERE namespace = $$1 AND key = $$2",  # noqa: S608
            self._namespace,
            key,
        )
        return None if raw is None else self._model.model_validate_json(raw)

    async def set(self, key: str, value: V) -> None:
        await self._pool.execute(
            f"INSERT INTO {self._table} (namespace, key, value) VALUES ($$1, $$2, $$3::jsonb) "  # noqa: S608
            "ON CONFLICT (namespace, key) DO UPDATE SET value = EXCLUDED.value",
            self._namespace,
            key,
            value.model_dump_json(),
        )

    async def delete(self, key: str) -> bool:
        status = await self._pool.execute(
            f"DELETE FROM {self._table} WHERE namespace = $$1 AND key = $$2",  # noqa: S608
            self._namespace,
            key,
        )
        return str(status).endswith(" 1")

    async def exists(self, key: str) -> bool:
        return bool(
            await self._pool.fetchval(
                f"SELECT EXISTS (SELECT 1 FROM {self._table} "  # noqa: S608
                "WHERE namespace = $$1 AND key = $$2)",
                self._namespace,
                key,
            )
        )

    async def keys(self) -> list[str]:
        rows = await self._pool.fetch(
            f"SELECT key FROM {self._table} WHERE namespace = $$1 ORDER BY key",  # noqa: S608
            self._namespace,
        )
        return [str(row["key"]) for row in rows]
