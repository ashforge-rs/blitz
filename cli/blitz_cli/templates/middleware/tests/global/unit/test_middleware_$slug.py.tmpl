from middleware.$slug import ${Pascal}Middleware


async def test_passes_requests_through() -> None:
    calls = []

    async def app(scope, receive, send) -> None:
        calls.append(scope["type"])

    middleware = ${Pascal}Middleware(app)
    for scope_type in ("http", "lifespan"):
        await middleware({"type": scope_type}, None, None)
    assert calls == ["http", "lifespan"]
